# Copy to .env and fill in a real key.
# rag-agent reads the *name* of this var from config.yaml (llm.api_key_env).

OPENAI_API_KEY=sk-replace-me

# ---------------------------------------------------------------------------
# Any config field can be overridden by an environment variable named
# RAG__<SECTION>__<FIELD>  (case-insensitive). Examples:
#
#   # point the LLM at DeepSeek (default)
#   RAG__LLM__BASE_URL=https://api.deepseek.com/v1
#   RAG__LLM__CHAT_MODEL=deepseek-chat
#
#   # embeddings often live on a different host than chat
#   RAG__EMBEDDING__BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   RAG__EMBEDDING__MODEL=embedding-3
#
#   # fully offline: no network calls at all
#   RAG__LLM__PROVIDER=mock
#   RAG__EMBEDDING__PROVIDER=mock
# ---------------------------------------------------------------------------
